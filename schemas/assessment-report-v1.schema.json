{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainercam.local/schemas/assessment-report-v1.schema.json",
  "title": "TrainerCam assessment report",
  "type": "object",
  "required": ["format", "schema_version", "created_at", "profile", "overall_score", "feature_scores", "improvements", "worst_segment", "alignment", "timing", "quality"],
  "properties": {
    "format": { "const": "trainercam.assessment-report" },
    "schema_version": { "const": 1 },
    "created_at": { "type": "string" },
    "profile": {
      "type": "object",
      "required": ["id", "display_name", "source_file"]
    },
    "overall_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "feature_scores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "joints", "axes", "weight", "score", "rms_error_deg", "p95_error_deg", "feedback"],
        "properties": {
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "rms_error_deg": { "type": "number", "minimum": 0 },
          "p95_error_deg": { "type": "number", "minimum": 0 },
          "feedback": { "type": ["string", "null"] }
        }
      }
    },
    "improvements": { "type": "array", "maxItems": 3 },
    "worst_segment": {
      "type": "object",
      "required": ["path_start", "path_end", "mean_error_deg", "customer_frame_index", "tutor_frame_index"]
    },
    "alignment": { "type": "object" },
    "timing": { "type": "object" },
    "quality": { "type": "object" }
  }
}
