{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainercam.local/schemas/release-manifest-v1.schema.json",
  "title": "TrainerCam release artifact manifest",
  "type": "object",
  "required": ["format", "schema_version", "created_at", "source_revision", "acceptance", "artifacts"],
  "properties": {
    "format": { "const": "trainercam.release-manifest" },
    "schema_version": { "const": 1 },
    "created_at": { "type": "string" },
    "source_revision": { "type": "string" },
    "acceptance": {
      "type": "object",
      "required": ["report", "passed", "sha256"]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component", "path", "size_bytes", "sha256"]
      }
    }
  }
}
